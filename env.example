# Django
SECRET_KEY=change-me
DEBUG=1
DJANGO_ENV=development
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Database
# Укажите строку подключения для Postgres/Cloud БД.
# Для локального SQLite явно включите флаг USE_SQLITE=1.
DATABASE_URL=
USE_SQLITE=1

# Admin seed (опционально - автоматическое создание суперпользователя при первом запуске)
# Используется командой: python manage.py auto_setup
DJANGO_SUPERUSER_PHONE=+998
DJANGO_SUPERUSER_PASSWORD=nurik123
DJANGO_SUPERUSER_NAME=Admin

